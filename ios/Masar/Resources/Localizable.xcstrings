    "guest_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أماكنك وسجلك محفوظة على هذا الجهاز فقط. سجّل الدخول لتحتفظ بها على كل أجهزتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your places and history are kept on this device only. Sign in to keep them on every device."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی جگہیں اور تاریخ صرف اس ڈیوائس پر محفوظ ہیں۔ انہیں ہر ڈیوائس پر رکھنے کے لیے سائن ان کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके स्थान और इतिहास केवल इस डिवाइस पर सहेजे गए हैं। हर डिवाइस पर रखने के लिए साइन इन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার স্থান ও ইতিহাস শুধু এই ডিভাইসে সংরক্ষিত। সব ডিভাইসে রাখতে সাইন ইন করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa device na ito lang naka-save ang iyong mga lugar at kasaysayan. Mag-sign in para nasa bawat device."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat dan riwayat Anda hanya tersimpan di perangkat ini. Masuk agar tersedia di setiap perangkat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的地点和记录仅保存在本设备上。登录后可在所有设备上使用。"
          }
        }
      }
    },
