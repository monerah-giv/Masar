    "loc_reason": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم مسار موقعك لإيجاد أقرب محطة مترو وعرضك على الخريطة. لا يغادر موقعك جهازك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar uses your location to find the nearest metro station and show you on the map. Your location stays on your device."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار آپ کا مقام قریب ترین میٹرو اسٹیشن تلاش کرنے اور نقشے پر دکھانے کے لیے استعمال کرتا ہے۔ آپ کا مقام آپ کے آلے پر ہی رہتا ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar आपकी लोकेशन से सबसे नज़दीकी मेट्रो स्टेशन ढूँढता है और आपको नक्शे पर दिखाता है। आपकी लोकेशन आपके डिवाइस पर ही रहती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar আপনার অবস্থান ব্যবহার করে নিকটতম মেট্রো স্টেশন খোঁজে এবং মানচিত্রে আপনাকে দেখায়। আপনার অবস্থান আপনার ডিভাইসেই থাকে।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ng Masar ang lokasyon mo para hanapin ang pinakamalapit na istasyon at ipakita ka sa mapa. Nananatili sa device mo ang lokasyon mo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar memakai lokasi Anda untuk mencari stasiun metro terdekat dan menampilkan Anda di peta. Lokasi Anda tetap di perangkat Anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar 使用你的位置查找最近的地铁站并在地图上显示你。你的位置只保留在设备上。"
          }
        }
      }
    },
    "loc_web_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين أنت؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کہاں ہیں؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कहाँ हैं?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কোথায়?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasaan ka?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda di mana?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在哪里？"
          }
        }
      }
    },
    "loc_web_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تسمح هذه الصفحة بقراءة موقع جهازك. افتح خرائط Google، واضغط على النقطة الزرقاء، وانسخ الرابط أو الإحداثيات والصقها هنا. في تطبيق iPhone يُحدَّد موقعك تلقائياً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page can't read your device's location. In Google Maps, tap your blue dot, copy the link or coordinates and paste them here. The iPhone app finds you automatically."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صفحہ آپ کے آلے کا مقام نہیں پڑھ سکتا۔ گوگل میپس میں اپنے نیلے نقطے پر ٹیپ کریں، لنک یا کوآرڈینیٹس کاپی کر کے یہاں چسپاں کریں۔ iPhone ایپ آپ کا مقام خود معلوم کرتی ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पेज आपके डिवाइस की लोकेशन नहीं पढ़ सकता। Google Maps में अपने नीले बिंदु पर टैप करें, लिंक या निर्देशांक कॉपी करके यहाँ चिपकाएँ। iPhone ऐप आपकी लोकेशन अपने आप ढूँढता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পেজ আপনার ডিভাইসের অবস্থান পড়তে পারে না। Google Maps-এ নীল বিন্দুতে ট্যাপ করুন, লিংক বা স্থানাঙ্ক কপি করে এখানে পেস্ট করুন। iPhone অ্যাপ আপনার অবস্থান নিজেই খুঁজে নেয়।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ng page na ito ang lokasyon ng device mo. Sa Google Maps, i-tap ang asul na tuldok, kopyahin ang link o coordinates at i-paste dito. Awtomatikong nahahanap ka ng iPhone app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ini tidak dapat membaca lokasi perangkat Anda. Di Google Maps, ketuk titik biru Anda, salin tautan atau koordinatnya lalu tempel di sini. Aplikasi iPhone menemukan lokasi Anda otomatis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面无法读取设备位置。请在 Google 地图中点按蓝点，复制链接或坐标后粘贴到这里。iPhone 应用会自动定位。"
          }
        }
      }
    },
