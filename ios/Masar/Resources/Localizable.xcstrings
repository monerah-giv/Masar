    "delete_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف كل ما حفظته من أماكن ومسارات وسجل رحلات من هذا الجهاز ومن iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes your places, routes and trip history from this device and iCloud."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آپ کی جگہیں، راستے اور سفر کی تاریخ اس ڈیوائس اور iCloud سے حذف ہو جائیں گی۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपके स्थान, मार्ग और यात्रा इतिहास इस डिवाइस और iCloud से हट जाएँगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে আপনার স্থান, রুট ও যাত্রার ইতিহাস এই ডিভাইস ও iCloud থেকে মুছে যাবে।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buburahin nito ang iyong mga lugar, ruta at kasaysayan ng biyahe sa device na ito at sa iCloud."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus tempat, rute, dan riwayat perjalanan Anda dari perangkat ini dan iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从本设备和 iCloud 中删除你的地点、路线和行程记录。"
