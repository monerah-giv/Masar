    "ad_slot_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض نشاطك لمن يصل إلى هذه المحطة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show your business to riders arriving here"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں پہنچنے والے مسافروں کو اپنا کاروبار دکھائیں"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ पहुँचने वाले यात्रियों को अपना व्यवसाय दिखाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে পৌঁছানো যাত্রীদের কাছে আপনার ব্যবসা দেখান"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita ang negosyo mo sa mga pasaherong dumarating dito"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan usaha Anda kepada penumpang yang tiba di sini"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向到达此站的乘客展示您的商家"
          }
        }
      }
    },
    "adv_open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلن معنا"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertise with us"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہمارے ساتھ اشتہار دیں"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारे साथ विज्ञापन दें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের সাথে বিজ্ঞাপন দিন"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-advertise sa amin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beriklan bersama kami"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投放广告"
          }
        }
      }
    },
    "adv_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلن لركاب المترو قرب نشاطك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach metro riders near your business"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے کاروبار کے قریب میٹرو مسافروں تک پہنچیں"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने व्यवसाय के पास मेट्रो यात्रियों तक पहुँचें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যবসার কাছে মেট্রো যাত্রীদের কাছে পৌঁছান"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Abutin ang mga pasahero ng metro malapit sa negosyo mo"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangkau penumpang metro di dekat usaha Anda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触达您店铺附近的地铁乘客"
          }
        }
      }
    },
    "adv_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر إعلانك لمن يتجه إلى المحطة القريبة منك، لحظة تخطيط رحلته."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ad appears to riders heading to the station near you, right as they plan the trip."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اشتہار ان مسافروں کو دکھتا ہے جو آپ کے قریبی اسٹیشن جا رہے ہیں، عین سفر کی منصوبہ بندی کے وقت۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका विज्ञापन उन यात्रियों को दिखता है जो आपके पास के स्टेशन जा रहे हैं, ठीक यात्रा की योजना बनाते समय।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কাছের স্টেশনে যাওয়া যাত্রীরা যাত্রা পরিকল্পনার সময়েই আপনার বিজ্ঞাপন দেখেন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas ang ad mo sa mga pasaherong papunta sa istasyong malapit sa iyo, habang pinaplano nila ang biyahe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan Anda tampil bagi penumpang yang menuju stasiun dekat Anda, tepat saat mereka merencanakan perjalanan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往您附近车站的乘客在规划行程时就会看到您的广告。"
          }
        }
      }
    },
    "adv_p1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر في نتيجة الرحلة عند محطة الوصول وفي صفحة المحطة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown in the trip result at the arrival station and on the station page"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سفر کے نتیجے میں منزل کے اسٹیشن پر اور اسٹیشن کے صفحے پر"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यात्रा परिणाम में गंतव्य स्टेशन पर और स्टेशन पेज पर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাত্রার ফলাফলে গন্তব্য স্টেশনে ও স্টেশনের পাতায়"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makikita sa resulta ng biyahe sa istasyong pupuntahan at sa pahina ng istasyon"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampil di hasil perjalanan pada stasiun tujuan dan di halaman stasiun"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在行程结果的到达站和车站页面"
          }
        }
      }
    },
    "adv_p2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعلان سياقي: لا تتبّع ولا جمع لبيانات الركاب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contextual: no tracking, no rider data collected"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیاق پر مبنی: نہ ٹریکنگ، نہ مسافروں کا ڈیٹا"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदर्भ आधारित: न ट्रैकिंग, न यात्रियों का डेटा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসঙ্গভিত্তিক: কোনো ট্র্যাকিং নেই, যাত্রীদের তথ্য সংগ্রহ নেই"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekstwal: walang tracking, walang kinokolektang data ng pasahero"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontekstual: tanpa pelacakan, tanpa mengumpulkan data penumpang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "情境投放：不追踪，不收集乘客数据"
          }
        }
      }
    },
    "adv_p3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بثماني لغات، مع اتجاهات المشي من المحطة إلى نشاطك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In 8 languages, with walking directions from the station to you"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "8 زبانوں میں، اسٹیشن سے آپ تک پیدل راستے کے ساتھ"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "8 भाषाओं में, स्टेशन से आप तक पैदल रास्ते के साथ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৮টি ভাষায়, স্টেশন থেকে আপনার কাছে হাঁটার পথসহ"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa 8 wika, may direksyon sa paglalakad mula istasyon papunta sa iyo"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam 8 bahasa, dengan petunjuk jalan kaki dari stasiun ke tempat Anda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持8种语言，并提供从车站到您店铺的步行路线"
          }
        }
      }
    },
