    "synced_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أماكنك ومساراتك وسجل رحلاتك وإعداداتك محفوظة في حسابك وتظهر على كل أجهزتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your places, routes, trip history and settings are saved to your account and follow you on every device."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی جگہیں، راستے، سفر کی تاریخ اور ترتیبات آپ کے اکاؤنٹ میں محفوظ ہیں اور ہر ڈیوائس پر دستیاب ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके स्थान, मार्ग, यात्रा इतिहास और सेटिंग्स आपके खाते में सहेजे जाते हैं और हर डिवाइस पर मिलते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার স্থান, রুট, যাত্রার ইতিহাস ও সেটিংস আপনার অ্যাকাউন্টে সংরক্ষিত থাকে এবং সব ডিভাইসে পাওয়া যায়।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save sa account mo ang iyong mga lugar, ruta, kasaysayan ng biyahe at setting, at kasama mo sa bawat device."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat, rute, riwayat perjalanan, dan pengaturan Anda tersimpan di akun dan ikut di setiap perangkat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的地点、路线、行程记录和设置会保存到账户，并在所有设备上同步。"
          }
        }
      }
    },
    "guest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زائر"
          }
