    "save_err": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحفظ في حسابك. التغييرات محفوظة على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save to your account. Changes are kept on this device."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ میں محفوظ نہیں ہو سکا۔ تبدیلیاں اس ڈیوائس پر محفوظ ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते में सहेजा नहीं जा सका। बदलाव इस डिवाइस पर रखे गए हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্টে সংরক্ষণ করা যায়নি। পরিবর্তন এই ডিভাইসে রাখা হয়েছে।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na-save sa account. Nasa device na ito ang mga pagbabago."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal menyimpan ke akun. Perubahan disimpan di perangkat ini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存到账户，更改已保存在本设备上。"
          }
        }
      }
