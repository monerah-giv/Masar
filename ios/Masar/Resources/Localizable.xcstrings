    "hours_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السبت إلى الخميس من 5:30 صباحاً حتى منتصف الليل. الجمعة من 8:00 صباحاً حتى منتصف الليل. تتغير الأوقات في رمضان والأعياد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saturday to Thursday 5:30 AM to midnight. Friday 8:00 AM to midnight. Hours change in Ramadan and on holidays."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہفتہ تا جمعرات صبح 5:30 سے آدھی رات تک۔ جمعہ صبح 8:00 سے آدھی رات تک۔ رمضان اور تعطیلات میں اوقات بدل جاتے ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शनिवार से गुरुवार सुबह 5:30 से आधी रात तक। शुक्रवार सुबह 8:00 से आधी रात तक। रमज़ान और छुट्टियों में समय बदलता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শনিবার থেকে বৃহস্পতিবার সকাল 5:30 থেকে মধ্যরাত। শুক্রবার সকাল 8:00 থেকে মধ্যরাত। রমজান ও ছুটিতে সময় বদলায়।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabado hanggang Huwebes 5:30 AM hanggang hatinggabi. Biyernes 8:00 AM hanggang hatinggabi. Nagbabago ang oras tuwing Ramadan at pista opisyal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabtu sampai Kamis 05.30 hingga tengah malam. Jumat 08.00 hingga tengah malam. Jam berubah saat Ramadan dan hari libur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周六至周四 5:30 至午夜；周五 8:00 至午夜。斋月和节假日时间会调整。"
          }
        }
      }
    },
