      }
    },
    "disc_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسعار المخفضة تقديرية، ويُتحقق من الأهلية في تطبيق درب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discounted prices are estimates. Eligibility is checked in Darb."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رعایتی قیمتیں تخمینی ہیں۔ اہلیت کی جانچ درب میں ہوتی ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छूट वाली कीमतें अनुमानित हैं। पात्रता Darb में जाँची जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছাড়ের দাম আনুমানিক। যোগ্যতা Darb-এ যাচাই হয়।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantiya lamang ang mga presyong may diskwento. Sinusuri sa Darb ang pagiging kwalipikado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga diskon adalah perkiraan. Kelayakan diperiksa di Darb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优惠价格为估算，资格以 Darb 审核为准。"
          }
        }
      }
    },
