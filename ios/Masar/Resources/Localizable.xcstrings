    "discount_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للطلاب من 6 إلى 18 سنة، وطلاب الجامعات، ومن هم في الستين فأكثر، والأشخاص ذوي الإعاقة ومرضى السرطان مع مرافق واحد لكل منهم، وذوي الشهداء من الدرجة الأولى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For students aged 6 to 18, university students, people aged 60 and over, people with disabilities and cancer patients (each with one companion), and first-degree relatives of martyrs."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "6 سے 18 سال کے طلبہ، یونیورسٹی طلبہ، 60 سال یا زائد عمر کے افراد، معذور افراد اور کینسر کے مریض (ہر ایک کے ساتھ ایک ساتھی)، اور شہداء کے فرسٹ ڈگری رشتہ داروں کے لیے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6 से 18 वर्ष के छात्र, विश्वविद्यालय के छात्र, 60 वर्ष या अधिक आयु के लोग, दिव्यांगजन और कैंसर रोगी (प्रत्येक के साथ एक सहायक), और शहीदों के प्रथम-श्रेणी के परिजनों के लिए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "6 থেকে 18 বছর বয়সী শিক্ষার্থী, বিশ্ববিদ্যালয়ের শিক্ষার্থী, 60 বছর বা তার বেশি বয়সী ব্যক্তি, প্রতিবন্ধী ব্যক্তি ও ক্যান্সার রোগী (প্রত্যেকের সঙ্গে একজন সহযাত্রী), এবং শহীদদের প্রথম-স্তরের আত্মীয়দের জন্য।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sa mga estudyanteng 6 hanggang 18 taong gulang, mga estudyante sa unibersidad, mga edad 60 pataas, mga taong may kapansanan at may kanser (bawat isa may isang kasama), at mga kamag-anak sa unang antas ng mga martir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk pelajar usia 6 sampai 18 tahun, mahasiswa, warga usia 60 tahun ke atas, penyandang disabilitas dan pasien kanker (masing-masing dengan satu pendamping), serta kerabat tingkat pertama para syuhada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于6至18岁学生、大学生、60岁及以上人士、残障人士和癌症患者（各可带一名陪同者），以及烈士的直系亲属。"
          }
        }
      }
    },
