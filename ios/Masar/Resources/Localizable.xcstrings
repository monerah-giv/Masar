    "cur_loc_sub": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحدّد موقعك ونختار أفضل محطة قريبة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll find you and pick the best nearby station"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کا مقام معلوم کر کے بہترین قریبی اسٹیشن چنیں گے"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपकी लोकेशन ढूँढकर सबसे अच्छा नज़दीकी स्टेशन चुनेंगे"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার অবস্থান খুঁজে সেরা কাছের স্টেশন বেছে নেব"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hahanapin ka namin at pipiliin ang pinakamainam na istasyon"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan menemukan Anda dan memilih stasiun terdekat terbaik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会定位你并选择附近最合适的车站"
          }
        }
      }
    },
    "via_station": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبر محطة {st} · {m} مشياً"
          }
        },
        "en": {
