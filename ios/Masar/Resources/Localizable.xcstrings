    "open_site": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح مسار بتحديد الموقع التلقائي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Masar with automatic location"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خودکار مقام کے ساتھ مسار کھولیں"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित लोकेशन के साथ Masar खोलें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয় অবস্থানসহ Masar খুলুন"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Masar na may awtomatikong lokasyon"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Masar dengan lokasi otomatis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开自动定位的 Masar"
          }
        }
      }
    },
    "loc_site_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحات Claude لا تسمح بقراءة موقع جهازك. افتح مسار في المتصفح ليحدّد موقعك تلقائياً، ويمكنك إضافته إلى الشاشة الرئيسية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages inside Claude can't read your device's location. Open Masar in your browser and it finds you automatically; you can also add it to your Home Screen."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude کے اندر صفحات آپ کا مقام نہیں پڑھ سکتے۔ مسار کو براؤزر میں کھولیں، یہ خود آپ کا مقام معلوم کرے گا؛ اسے ہوم اسکرین پر بھی شامل کر سکتے ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude के अंदर के पेज आपकी लोकेशन नहीं पढ़ सकते। Masar को ब्राउज़र में खोलें, यह आपकी लोकेशन अपने आप ढूँढेगा; आप इसे होम स्क्रीन पर भी जोड़ सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-এর ভেতরের পেজ আপনার অবস্থান পড়তে পারে না। ব্রাউজারে Masar খুলুন, এটি নিজেই আপনার অবস্থান খুঁজে নেবে; হোম স্ক্রিনেও যোগ করতে পারেন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ng mga page sa loob ng Claude ang lokasyon mo. Buksan ang Masar sa browser at awtomatiko ka nitong mahahanap; puwede mo rin itong idagdag sa Home Screen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman di dalam Claude tidak dapat membaca lokasi Anda. Buka Masar di browser dan lokasi Anda ditemukan otomatis; Anda juga bisa menambahkannya ke Layar Utama."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 内的页面无法读取设备位置。在浏览器中打开 Masar 即可自动定位，也可以添加到主屏幕。"
          }
        }
      }
    },
