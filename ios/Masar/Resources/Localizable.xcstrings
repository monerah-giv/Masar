    "loc_denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار لا يملك إذن الوصول إلى موقعك. فعّله من الإعدادات ← مسار ← الموقع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar can't see your location. Turn it on in Settings › Masar › Location."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار کو آپ کے مقام تک رسائی نہیں۔ ترتیبات › مسار › مقام سے اجازت دیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar को आपकी लोकेशन की अनुमति नहीं है। सेटिंग्स › Masar › लोकेशन में चालू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar আপনার অবস্থান দেখতে পারছে না। সেটিংস › Masar › অবস্থান থেকে চালু করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makita ng Masar ang lokasyon mo. I-on ito sa Settings › Masar › Location."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar tidak dapat melihat lokasi Anda. Aktifkan di Pengaturan › Masar › Lokasi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar 无法获取你的位置。请在“设置 › Masar › 位置”中开启。"
          }
        }
      }
    },
    "loc_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
