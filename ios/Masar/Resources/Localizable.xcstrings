    "about_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار مخطط رحلات مستقل وغير تابع لقطار الرياض أو الهيئة الملكية لمدينة الرياض. أزمنة الرحلات تقديرية مبنية على أطوال المسارات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar is an independent trip planner and is not affiliated with Riyadh Metro or the Royal Commission for Riyadh City. Journey times are estimates based on line lengths."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار ایک آزاد سفر پلانر ہے اور ریاض میٹرو یا رائل کمیشن فار ریاض سٹی سے وابستہ نہیں۔ سفر کے اوقات لائنوں کی لمبائی پر مبنی اندازے ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar एक स्वतंत्र यात्रा योजनाकार है और रियाद मेट्रो या रॉयल कमीशन फ़ॉर रियाद सिटी से संबद्ध नहीं है। यात्रा समय लाइनों की लंबाई पर आधारित अनुमान हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar একটি স্বাধীন যাত্রা পরিকল্পনাকারী, রিয়াদ মেট্রো বা রয়্যাল কমিশন ফর রিয়াদ সিটির সঙ্গে যুক্ত নয়। যাত্রার সময় লাইনের দৈর্ঘ্যের ভিত্তিতে আনুমানিক।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Masar ay isang independiyenteng tagaplano ng biyahe at hindi kaanib ng Riyadh Metro o ng Royal Commission for Riyadh City. Tantiya ang mga oras ng biyahe batay sa haba ng mga linya."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar adalah perencana perjalanan independen dan tidak berafiliasi dengan Metro Riyadh atau Royal Commission for Riyadh City. Waktu perjalanan adalah perkiraan berdasarkan panjang jalur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Masar 是独立的行程规划应用，与利雅得地铁及利雅得市皇家委员会无关。行程时间根据线路长度估算。"
          }
        }
      }
    },
    "data_model": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات والخوارزمية"
