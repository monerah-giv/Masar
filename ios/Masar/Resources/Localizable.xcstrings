    "loc_bad": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتعرّف على موقع داخل الرياض. جرّب رابطاً من خرائط Google أو إحداثيات مثل 24.71, 46.67."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a place in Riyadh. Try a Google Maps link or coordinates like 24.71, 46.67."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ریاض کا کوئی مقام نہیں لگتا۔ گوگل میپس لنک یا 24.71, 46.67 جیسے کوآرڈینیٹس آزمائیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रियाद की कोई जगह नहीं लगती। Google Maps लिंक या 24.71, 46.67 जैसे निर्देशांक आज़माएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি রিয়াদের কোনো স্থান মনে হচ্ছে না। Google Maps লিংক বা 24.71, 46.67-এর মতো স্থানাঙ্ক দিন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang hindi ito lugar sa Riyadh. Subukan ang link ng Google Maps o coordinates tulad ng 24.71, 46.67."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu bukan lokasi di Riyadh. Coba tautan Google Maps atau koordinat seperti 24.71, 46.67."
          }
        },
        "zh-Hans": {
          "stringUnit": {
