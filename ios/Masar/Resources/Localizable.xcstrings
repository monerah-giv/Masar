    "ad_slot": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة إعلانية متاحة قرب محطة {st}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad space available near {st}"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "{st} کے قریب اشتہار کی جگہ دستیاب"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{st} के पास विज्ञापन स्थान उपलब्ध"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "{st}-এর কাছে বিজ্ঞাপনের জায়গা খালি"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May bakanteng ad space malapit sa {st}"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang iklan tersedia dekat {st}"
          }
        },
