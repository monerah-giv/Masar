    },
    "best_stop_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترنا المحطة التي توصلك أسرع، وليست بالضرورة الأقرب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We picked the station that gets you there fastest, not always the nearest."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم نے وہ اسٹیشن چنا جو آپ کو سب سے جلد پہنچائے، ضروری نہیں کہ قریب ترین ہو۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने वह स्टेशन चुना जो आपको सबसे जल्दी पहुँचाए, ज़रूरी नहीं कि सबसे नज़दीकी हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা সেই স্টেশন বেছেছি যা আপনাকে দ্রুত পৌঁছে দেয়, সবসময় নিকটতম নয়।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinili namin ang istasyong pinakamabilis kang madadala, hindi laging ang pinakamalapit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami memilih stasiun yang paling cepat mengantar Anda, tidak selalu yang terdekat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们选择了最快到达的车站，不一定是最近的。"
          }
        }
      }
    },
    "walk_only": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجهتك قريبة: {m} مشياً"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your destination is close: {m} walk"
