    "empty_places": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ المنزل أو العمل أو أي محطة تستخدمها كثيراً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save home, work or any station you use often."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھر، دفتر یا اکثر استعمال ہونے والا کوئی اسٹیشن محفوظ کریں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर, दफ़्तर या अक्सर इस्तेमाल होने वाला स्टेशन सहेजें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাড়ি, অফিস বা প্রায়ই ব্যবহৃত স্টেশন সংরক্ষণ করুন।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-save ang bahay, trabaho, o istasyong madalas mong gamitin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan rumah, kantor, atau stasiun yang sering Anda gunakan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏家、公司或常用车站。"
          }
        }
      }
    },
    "empty_routes": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «احفظ المسار» في أي رحلة لتظهر هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Save route on a trip to keep it here."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی سفر پر «راستہ محفوظ کریں» دبائیں تاکہ یہاں آ جائے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी यात्रा पर «मार्ग सहेजें» दबाएँ, वह यहाँ दिखेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো যাত্রায় «রুট সংরক্ষণ» চাপুন, এখানে দেখা যাবে।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang I-save ang ruta para makita rito."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Simpan rute pada perjalanan agar muncul di sini."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在行程中点击“收藏路线”即可保存到这里。"
          }
        }
      }
    },
    "empty_recent": {
      "extractionState": "manual",
      "localizations": {
