    "adv_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسعار تقديرية، ويُؤكَّد الحجز بعد مراجعة الإعلان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are estimates; bookings are confirmed after the ad is reviewed."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمتیں تخمینی ہیں؛ اشتہار کے جائزے کے بعد بکنگ کی تصدیق ہوتی ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीमतें अनुमानित हैं; विज्ञापन की समीक्षा के बाद बुकिंग पक्की होती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল্য আনুমানিক; বিজ্ঞাপন যাচাইয়ের পর বুকিং নিশ্চিত হয়।"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantya lang ang presyo; kinukumpirma ang booking pagkatapos suriin ang ad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga bersifat perkiraan; pemesanan dikonfirmasi setelah iklan ditinjau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格为预估，广告审核后确认预订。"
          }
        }
      }
    },
